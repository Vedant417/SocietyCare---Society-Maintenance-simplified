# Frontend Environment Variables
VITE_API_URL=http://localhost:5000

# Backend Environment Variables
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestfix?schema=public
JWT_SECRET=supersecretjwttokenchangeinproduction
CLIENT_URL=http://localhost:5173

# Cloudinary (Photo Storage) Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service Configuration (e.g. Resend, Brevo, SendGrid or SMTP)
# Leave empty or set to MOCK in development to skip sending real emails
EMAIL_SERVICE_PROVIDER=MOCK
EMAIL_API_KEY=your_email_api_key
EMAIL_FROM=Nestfix <noreply@yourdomain.com>

# System Defaults
OVERDUE_DAYS=3
